#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>

#define BUFFER_SIZE 4096

int main(int argc, char *argv[]) {
    int src, dest;
    char buffer[BUFFER_SIZE];
    ssize_t bytes_read, bytes_written;

    if (argc != 3) {
        printf("Usage: %s <source> <destination>\n", argv[0]);
        return 1;
    }

    // Open source file for reading
    src = open(argv[1], O_RDONLY);

    if (src < 0) {
        perror("Error opening source file");
        return 1;
    }

    // Open/create destination file
    dest = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (dest < 0) {
        perror("Error opening destination file");
        close(src);
        return 1;
    }

    // Copy data using read() and write()
    while ((bytes_read = read(src, buffer, BUFFER_SIZE)) > 0) {

        bytes_written = write(dest, buffer, bytes_read);

        if (bytes_written != bytes_read) {
            perror("Error writing to destination");
            close(src);
            close(dest);
            return 1;
        }
    }

    if (bytes_read < 0) {
        perror("Error reading source file");
    }

    // Demonstrate lseek()
    if (lseek(src, 0, SEEK_SET) == (off_t)-1) {
        perror("lseek failed");
    }

    close(src);
    close(dest);

    printf("File copied successfully using low-level system calls.\n");

    return 0;
}
