
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>

int main() {
    pid_t pids[3];

    printf("Parent process PID: %d\n", getpid());

    for (int i = 0; i < 3; i++) {
        pids[i] = fork();

        if (pids[i] < 0) {
            perror("fork failed");
            exit(1);
        }

        if (pids[i] == 0) {
            printf("Child %d: PID = %d, Parent PID = %d\n",
                   i + 1, getpid(), getppid());

            sleep(2 + i);

            printf("Child %d completed.\n", i + 1);
            exit(0);
        }
    }

    printf("\nParent waiting using waitpid()...\n");

    for (int i = 0; i < 3; i++) {
        int status;
        pid_t child = waitpid(pids[i], &status, 0);

        if (child > 0) {
            printf("Parent collected child PID: %d\n", child);
        }
    }

    printf("All children completed.\n");

    return 0;
}
