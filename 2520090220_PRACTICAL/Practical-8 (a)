#include <stdio.h>
#include <stdlib.h>

int main() {
    int i;

    // malloc()
    int *arr = (int *)malloc(5 * sizeof(int));

    if (arr == NULL) {
        printf("malloc failed\n");
        return 1;
    }

    printf("Memory allocated using malloc()\n");

    for (i = 0; i < 5; i++) {
        arr[i] = (i + 1) * 10;
    }

    printf("Values using malloc: ");
    for (i = 0; i < 5; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // calloc()
    int *zero_arr = (int *)calloc(5, sizeof(int));

    if (zero_arr == NULL) {
        printf("calloc failed\n");
        free(arr);
        return 1;
    }

    printf("Memory allocated using calloc()\n");

    printf("Values using calloc: ");
    for (i = 0; i < 5; i++) {
        printf("%d ", zero_arr[i]);
    }
    printf("\n");

    // realloc()
    arr = (int *)realloc(arr, 10 * sizeof(int));

    if (arr == NULL) {
        printf("realloc failed\n");
        free(zero_arr);
        return 1;
    }

    printf("Memory resized using realloc()\n");

    for (i = 5; i < 10; i++) {
        arr[i] = (i + 1) * 10;
    }

    printf("Values after realloc: ");
    for (i = 0; i < 10; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // free()
    free(arr);
    free(zero_arr);

    printf("Memory released using free()\n");

    return 0;
}
