#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define SIZE 1000000

int main() {
    int *data = malloc(SIZE * sizeof(int));

    if (data == NULL) {
        perror("malloc");
        return 1;
    }

    for (int i = 0; i < SIZE; i++) {
        data[i] = i;
    }

    printf("Parent PID: %d\n", getpid());
    printf("Memory initialized. Press Enter to create child...\n");
    getchar();

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork");
        free(data);
        return 1;
    }

    if (pid == 0) {
        printf("Child PID: %d\n", getpid());
        printf("Child created. Memory is initially shared using Copy-on-Write.\n");
        printf("Press Enter to modify memory...\n");
        getchar();

        for (int i = 0; i < SIZE; i++) {
            data[i] = data[i] + 100;
        }

        printf("Child modified the memory.\n");
        printf("Press Enter to exit child...\n");
        getchar();

        free(data);
        return 0;
    }
    else {
        printf("Parent created child PID: %d\n", pid);
        printf("Parent waiting...\n");

        wait(NULL);

        printf("Parent data[0] = %d\n", data[0]);

        free(data);
    }

    return 0;
}
