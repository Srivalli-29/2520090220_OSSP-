#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int input_fd, output_fd;

    // Open input file
    input_fd = open("input.txt", O_RDONLY);

    if (input_fd < 0) {
        perror("Error opening input.txt");
        return 1;
    }

    // Open output file
    output_fd = open("output.txt",
                     O_WRONLY | O_CREAT | O_TRUNC,
                     0644);

    if (output_fd < 0) {
        perror("Error opening output.txt");
        close(input_fd);
        return 1;
    }

    // Redirect standard input to input.txt
    if (dup2(input_fd, STDIN_FILENO) < 0) {
        perror("dup2 stdin");
        return 1;
    }

    // Redirect standard output to output.txt
    if (dup2(output_fd, STDOUT_FILENO) < 0) {
        perror("dup2 stdout");
        return 1;
    }

    close(input_fd);
    close(output_fd);

    // stdin now comes from input.txt
    // stdout now goes to output.txt

    char buffer[100];
    ssize_t bytes_read;

    bytes_read = read(STDIN_FILENO, buffer, sizeof(buffer) - 1);

    if (bytes_read < 0) {
        perror("read");
        return 1;
    }

    buffer[bytes_read] = '\0';

    printf("Data read through redirected stdin:\n");
    printf("%s\n", buffer);

    return 0;
}
