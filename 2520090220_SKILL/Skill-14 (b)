
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

int main(void) {
    char input[200];
    char filename[100];
    char *symbol;
    int fd;

    printf("Enter command (example: ls missing.txt 2> errors.txt): ");
    fflush(stdout);

    if (fgets(input, sizeof(input), stdin) == NULL)
        return 1;

    input[strcspn(input, "\n")] = '\0';
    symbol = strstr(input, "2>");

    if (symbol == NULL) {
        printf("Error redirection operator '2>' not found.\n");
        return 1;
    }

    *symbol = '\0';
    char *command = input;
    char *file = symbol + 2;

    while (*file == ' ')
        file++;

    if (*command == '\0' || *file == '\0') {
        printf("Command or filename is missing.\n");
        return 1;
    }

    if (sscanf(file, "%99s", filename) != 1) {
        printf("Invalid filename.\n");
        return 1;
    }

    fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd == -1) {
        perror("open error file");
        return 1;
    }

    pid_t pid = fork();

    if (pid == -1) {
        perror("fork");
        close(fd);
        return 1;
    }

    if (pid == 0) {
        if (dup2(fd, STDERR_FILENO) == -1) {
            perror("dup2");
            close(fd);
            _exit(1);
        }

        close(fd);

        execl("/bin/sh", "sh", "-c", command, (char *)NULL);

        perror("execl");
        _exit(127);
    }

    close(fd);

    int status;

    if (waitpid(pid, &status, 0) == -1) {
        perror("waitpid");
        return 1;
    }

    printf("Error output saved to %s\n", filename);

    if (WIFEXITED(status))
        printf("Command exit status: %d\n", WEXITSTATUS(status));

    return 0;
}
