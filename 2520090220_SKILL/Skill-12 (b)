
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

#define MAX_COMMANDS 5
#define MAX_LENGTH 100

int main(void) {
    char commands[MAX_COMMANDS][MAX_LENGTH];
    int pipes[MAX_COMMANDS - 1][2];
    pid_t pids[MAX_COMMANDS];
    int n;

    printf("Enter number of commands (2-5): ");

    if (scanf("%d", &n) != 1 || n < 2 ||
        n > MAX_COMMANDS) {
        printf("Invalid number of commands.\n");
        return 1;
    }

    getchar();

    for (int i = 0; i < n; i++) {
        printf("Enter command %d: ", i + 1);

        if (fgets(commands[i], MAX_LENGTH, stdin) == NULL)
            return 1;

        commands[i][strcspn(commands[i], "\n")] = '\0';

        if (commands[i][0] == '\0') {
            printf("Empty command is not allowed.\n");
            return 1;
        }
    }

    for (int i = 0; i < n - 1; i++) {
        if (pipe(pipes[i]) == -1) {
            perror("pipe");

            for (int j = 0; j < i; j++) {
                close(pipes[j][0]);
                close(pipes[j][1]);
            }

            return 1;
        }
    }

    printf("\nPipeline layout:\n");
    for (int i = 0; i < n; i++) {
        printf("%s", commands[i]);
        if (i < n - 1)
            printf(" | ");
    }
    printf("\n");

    int launched = 0;

    for (int i = 0; i < n; i++) {
        pid_t pid = fork();

        if (pid == -1) {
            perror("fork");
            break;
        }

        if (pid == 0) {
            if (i > 0)
                dup2(pipes[i - 1][0], STDIN_FILENO);

            if (i < n - 1)
                dup2(pipes[i][1], STDOUT_FILENO);

            for (int j = 0; j < n - 1; j++) {
                close(pipes[j][0]);
                close(pipes[j][1]);
            }

            execl("/bin/sh", "sh", "-c",
                  commands[i], (char *)NULL);

            perror("execl");
            _exit(127);
        }

        pids[i] = pid;
        launched++;
    }

    for (int i = 0; i < n - 1; i++) {
        close(pipes[i][0]);
        close(pipes[i][1]);
    }

    int failed = (launched != n);

    for (int i = 0; i < launched; i++) {
        int status;

        if (waitpid(pids[i], &status, 0) == -1) {
            perror("waitpid");
            failed = 1;
        } else if (!WIFEXITED(status) ||
                   WEXITSTATUS(status) != 0) {
            failed = 1;
        }
    }

    if (failed) {
        printf("Pipeline execution failed.\n");
        return 1;
    }

    printf("Multiple-pipe execution completed successfully.\n");
    return 0;
}
