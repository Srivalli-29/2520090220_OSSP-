#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    pid_t pid, result;
    int status;

    printf("Parent process started. PID = %d\n", getpid());

    pid = fork();

    if (pid < 0) {
        perror("fork");
        return 1;
    }

    if (pid == 0) {
        printf("Child process started. PID = %d, PPID = %d\n",
               getpid(), getppid());

        sleep(3);

        printf("Child process completed.\n");
        exit(42);
    }

    printf("Parent is waiting for child using waitpid()...\n");

    result = waitpid(pid, &status, 0);

    if (result == -1) {
        perror("waitpid");
        return 1;
    }

    if (WIFEXITED(status)) {
        printf("Child terminated normally.\n");
        printf("Child exit status = %d\n", WEXITSTATUS(status));
    }

    printf("Parent process completed.\n");

    return 0;
}
