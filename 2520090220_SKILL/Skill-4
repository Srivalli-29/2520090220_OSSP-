#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 100

typedef struct {
    char token[50];
    char type[20];
} Token;

Token tokens[MAX];
int count = 0;

void addToken(const char *token, const char *type) {
    strcpy(tokens[count].token, token);
    strcpy(tokens[count].type, type);
    count++;
}

void tokenize(char *input) {
    int i = 0;

    while (input[i] != '\0') {

        // Handle whitespace
        if (isspace(input[i])) {
            i++;
            continue;
        }

        // Identify delimiters/operators
        if (input[i] == '+' || input[i] == '-' ||
            input[i] == '*' || input[i] == '/' ||
            input[i] == '=' || input[i] == '(' ||
            input[i] == ')' || input[i] == ';') {

            char temp[2];
            temp[0] = input[i];
            temp[1] = '\0';

            addToken(temp, "DELIMITER");
            i++;
        }

        // Identify numbers
        else if (isdigit(input[i])) {
            char temp[50];
            int j = 0;

            while (isdigit(input[i])) {
                temp[j++] = input[i++];
            }

            temp[j] = '\0';
            addToken(temp, "NUMBER");
        }

        // Identify identifiers
        else if (isalpha(input[i])) {
            char temp[50];
            int j = 0;

            while (isalnum(input[i])) {
                temp[j++] = input[i++];
            }

            temp[j] = '\0';
            addToken(temp, "IDENTIFIER");
        }

        // Invalid character
        else {
            printf("Lexical Error: Invalid character '%c'\n", input[i]);
            i++;
        }
    }
}

void displayTokens() {
    printf("\n--- TOKEN STREAM ---\n");

    for (int i = 0; i < count; i++) {
        printf("Token: %-10s Type: %s\n",
               tokens[i].token,
               tokens[i].type);
    }
}

void validateTokens() {
    printf("\n--- TOKEN VALIDATION ---\n");

    if (count == 0) {
        printf("Empty command detected.\n");
        return;
    }

    for (int i = 0; i < count; i++) {
        if (strcmp(tokens[i].type, "IDENTIFIER") == 0 ||
            strcmp(tokens[i].type, "NUMBER") == 0 ||
            strcmp(tokens[i].type, "DELIMITER") == 0) {
            printf("Token '%s' : Valid\n", tokens[i].token);
        }
    }
}

void generateParseTree() {
    printf("\n--- PARSE TREE / EXECUTION STRUCTURE ---\n");

    if (count == 0) {
        printf("No parse tree generated for empty command.\n");
        return;
    }

    printf("COMMAND\n");

    for (int i = 0; i < count; i++) {
        printf("  |\n");
        printf("  +-- %s [%s]\n",
               tokens[i].token,
               tokens[i].type);
    }
}

int main() {
    char input[MAX];

    printf("Enter a command/expression: ");
    fgets(input, sizeof(input), stdin);

    // Remove newline
    input[strcspn(input, "\n")] = '\0';

    tokenize(input);
    displayTokens();
    validateTokens();
    generateParseTree();

    printf("\nParsing completed successfully.\n");

    return 0;
}
