#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <limits.h>
#include <string.h>

int main() {
    char path[PATH_MAX];
    char state[100];

    if (getcwd(path, sizeof(path)) != NULL) {
        printf("Current Directory: %s\n", path);
    } else {
        perror("getcwd");
        return 1;
    }

    printf("Enter state to save: ");
    if (fgets(state, sizeof(state), stdin) == NULL) {
        return 1;
    }

    FILE *fp = fopen("state.txt", "w");
    if (fp == NULL) {
        perror("fopen");
        return 1;
    }

    fprintf(fp, "Directory: %s\nState: %s", path, state);

    if (fclose(fp) != 0) {
        perror("fclose");
        return 1;
    }

    printf("State saved successfully.\n");
    printf("Resources cleaned up.\n");
    printf("Exiting program.\n");

    return 0;
}
