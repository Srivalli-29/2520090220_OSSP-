#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 200

void printNestedTokens(char *str) {
    char temp[MAX];
    char *token;
    int tokenNumber = 1;

    strcpy(temp, str);

    printf("\n--- NESTED TOKENS ---\n");

    token = strtok(temp, " ");

    while (token != NULL) {
        printf("Token %d: %s\n", tokenNumber, token);
        tokenNumber++;
        token = strtok(NULL, " ");
    }

    if (tokenNumber == 1) {
        printf("No nested tokens found.\n");
    }
}

void parseSingleQuotes(char *input) {
    char result[MAX];
    int i = 0, j = 0;

    result[0] = '\0';

    printf("\n--- SINGLE QUOTE PARSING ---\n");

    while (input[i] != '\0') {

        if (input[i] == '\'') {
            i++;

            while (input[i] != '\0' && input[i] != '\'') {
                result[j++] = input[i++];
            }

            if (input[i] == '\'') {
                i++;
            } else {
                printf("Error: Missing closing single quote.\n");
                return;
            }
        } else {
            result[j++] = input[i++];
        }
    }

    result[j] = '\0';

    printf("Stored literal string: %s\n", result);
    printf("Variable expansion: IGNORED\n");
    printf("Parsing result: VALID\n");
}

void parseDoubleQuotes(char *input) {
    char result[MAX];
    int i = 0, j = 0;

    result[0] = '\0';

    printf("\n--- DOUBLE QUOTE PARSING ---\n");

    while (input[i] != '\0') {

        if (input[i] == '"') {
            i++;

            while (input[i] != '\0' && input[i] != '"') {

                if (input[i] == '$') {
                    char variable[50];
                    int k = 0;

                    i++;

                    while (input[i] != '\0' &&
                           input[i] != '"' &&
                           input[i] != ' ' &&
                           input[i] != '$') {

                        variable[k++] = input[i++];
                    }

                    variable[k] = '\0';

                    printf("Variable expansion detected: $%s\n",
                           variable);

                    strcat(result, "<expanded>");
                    j = strlen(result);
                } else {
                    result[j++] = input[i++];
                    result[j] = '\0';
                }
            }

            if (input[i] == '"') {
                i++;
            } else {
                printf("Error: Missing closing double quote.\n");
                return;
            }
        } else {
            result[j++] = input[i++];
            result[j] = '\0';
        }
    }

    result[j] = '\0';

    printf("Stored string: %s\n", result);
    printf("Spaces preserved: YES\n");
    printf("Parsing result: VALID\n");

    /* Explicitly demonstrate nested tokens */
    printNestedTokens(result);
}

void testSingleQuote() {
    char input[MAX];

    printf("\nEnter a single-quoted string: ");
    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    parseSingleQuotes(input);
}

void testDoubleQuote() {
    char input[MAX];

    printf("\nEnter a double-quoted string: ");
    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    parseDoubleQuotes(input);
}

int main() {
    int choice;

    printf("===== SKILL 5: QUOTED STRING PARSER =====\n");

    printf("\n1. Single Quotes");
    printf("\n2. Double Quotes");
    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    getchar();

    if (choice == 1) {
        testSingleQuote();
    }
    else if (choice == 2) {
        testDoubleQuote();
    }
    else {
        printf("Invalid choice.\n");
    }

    printf("\nParsing completed successfully.\n");

    return 0;
}
