
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

int main(void) {
    char input[200];
    char filename[100];
    char *symbol;
    int fd;
    int saved_stdout;

    printf("Enter command (example: Hello Skill13 > output.txt): ");
    fflush(stdout);

    if (fgets(input, sizeof(input), stdin) == NULL)
        return 1;

    input[strcspn(input, "\n")] = '\0';
    symbol = strchr(input, '>');

    if (symbol == NULL) {
        printf("Output redirection symbol '>' not found.\n");
        return 1;
    }

    *symbol = '\0';
    char *message = input;
    char *file = symbol + 1;

    while (*file == ' ')
        file++;

    if (*file == '\0') {
        printf("Filename is missing.\n");
        return 1;
    }

    if (sscanf(file, "%99s", filename) != 1) {
        printf("Invalid filename.\n");
        return 1;
    }

    while (*message == ' ')
        message++;

    fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd == -1) {
        perror("open");
        return 1;
    }

    saved_stdout = dup(STDOUT_FILENO);

    if (saved_stdout == -1) {
        perror("dup");
        close(fd);
        return 1;
    }

    fflush(stdout);

    if (dup2(fd, STDOUT_FILENO) == -1) {
        perror("dup2");
        close(fd);
        close(saved_stdout);
        return 1;
    }

    close(fd);

    printf("%s\n", message);
    fflush(stdout);

    if (dup2(saved_stdout, STDOUT_FILENO) == -1) {
        perror("restore stdout");
        close(saved_stdout);
        return 1;
    }

    close(saved_stdout);

    printf("Output redirected successfully to %s\n", filename);

    return 0;
}
