#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

int main() {
    int n, newSize;

    // 1. Allocate buffer dynamically
    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size.\n");
        return 1;
    }

    int *arr = malloc(n * sizeof(int));

    if (arr == NULL) {
        printf("Memory allocation failed.\n");
        return 1;
    }

    // 2. Prevent buffer overflow using bounds
    printf("Enter %d elements:\n", n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Array elements:\n");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    // 3. Resize array
    printf("\nEnter new array size: ");
    scanf("%d", &newSize);

    if (newSize <= 0) {
        printf("Invalid new size.\n");
        free(arr);
        return 1;
    }

    int *temp = realloc(arr, newSize * sizeof(int));

    if (temp == NULL) {
        printf("Memory reallocation failed.\n");
        free(arr);
        return 1;
    }

    arr = temp;

    printf("Array resized successfully.\n");

    // 4. Create linked list
    struct Node *head = NULL;

    for (int i = 1; i <= 3; i++) {
        struct Node *newNode = malloc(sizeof(struct Node));

        if (newNode == NULL) {
            printf("Memory allocation failed.\n");
            free(arr);
            return 1;
        }

        newNode->data = i * 10;
        newNode->next = head;
        head = newNode;
    }

    // 5. Display linked list
    printf("Linked list elements:\n");

    struct Node *current = head;

    while (current != NULL) {
        printf("%d ", current->data);
        current = current->next;
    }

    // 6. Release linked list memory
    current = head;

    while (current != NULL) {
        struct Node *next = current->next;
        free(current);
        current = next;
    }

    // 7. Release array memory
    free(arr);

    printf("\nMemory released successfully.\n");

    return 0;
}
