#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <limits.h>

int main(int argc, char *argv[]) {
    char *path;
    char *path_copy;
    char *dir;
    char full_path[PATH_MAX];

    if (argc != 2) {
        printf("Usage: %s <command>\n", argv[0]);
        return 1;
    }

    path = getenv("PATH");

    if (path == NULL) {
        printf("PATH variable not found.\n");
        return 1;
    }

    printf("PATH variable:\n%s\n\n", path);

    path_copy = strdup(path);

    if (path_copy == NULL) {
        perror("strdup");
        return 1;
    }

    dir = strtok(path_copy, ":");

    while (dir != NULL) {
        snprintf(full_path, sizeof(full_path), "%s/%s",
                 dir, argv[1]);

        if (access(full_path, F_OK) == 0) {
            printf("Found: %s\n", full_path);

            if (access(full_path, X_OK) == 0) {
                printf("Executable permission: YES\n");
                printf("Command resolved successfully.\n");
                free(path_copy);
                return 0;
            } else {
                printf("Executable permission: NO\n");
            }
        }

        dir = strtok(NULL, ":");
    }

    printf("Command '%s' not found in PATH.\n", argv[1]);

    free(path_copy);
    return 1;
}
