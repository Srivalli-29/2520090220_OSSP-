
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

int main(void) {
    char input[200];
    char filename[100];
    char *symbol;
    int fd;
    int saved_stdin;

    printf("Enter command (example: count < input.txt): ");

    if (fgets(input, sizeof(input), stdin) == NULL)
        return 1;

    input[strcspn(input, "\n")] = '\0';
    symbol = strchr(input, '<');

    if (symbol == NULL) {
        printf("Input redirection symbol '<' not found.\n");
        return 1;
    }

    *symbol = '\0';
    char *command = input;
    char *file = symbol + 1;

    while (*file == ' ')
        file++;

    while (*command == ' ')
        command++;

    if (*file == '\0') {
        printf("Filename is missing.\n");
        return 1;
    }

    if (sscanf(file, "%99s", filename) != 1) {
        printf("Invalid filename.\n");
        return 1;
    }

    fd = open(filename, O_RDONLY);

    if (fd == -1) {
        perror("open");
        return 1;
    }

    saved_stdin = dup(STDIN_FILENO);

    if (saved_stdin == -1) {
        perror("dup");
        close(fd);
        return 1;
    }

    if (dup2(fd, STDIN_FILENO) == -1) {
        perror("dup2");
        close(fd);
        close(saved_stdin);
        return 1;
    }

    close(fd);

    printf("Reading input from file: %s\n", filename);

    char buffer[256];
    ssize_t bytes;

    while ((bytes = read(STDIN_FILENO, buffer, sizeof(buffer))) > 0) {
        if (write(STDOUT_FILENO, buffer, (size_t)bytes) == -1) {
            perror("write");
            break;
        }
    }

    if (bytes == -1)
        perror("read");

    if (dup2(saved_stdin, STDIN_FILENO) == -1) {
        perror("restore stdin");
        close(saved_stdin);
        return 1;
    }

    close(saved_stdin);
    printf("\nInput redirection completed.\n");

    return bytes == -1 ? 1 : 0;
}
